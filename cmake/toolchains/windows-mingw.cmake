# macOS/Linux host -> Windows x64. Install mingw-w64 and a Windows Qt SDK.
set(CMAKE_SYSTEM_NAME Windows)
set(CMAKE_SYSTEM_PROCESSOR AMD64)
find_program(ZLL_WINDOWS_AR x86_64-w64-mingw32-ar REQUIRED)
find_program(ZLL_WINDOWS_RANLIB x86_64-w64-mingw32-ranlib REQUIRED)
set(CMAKE_AR "${ZLL_WINDOWS_AR}" CACHE FILEPATH "Windows archiver" FORCE)
set(CMAKE_RANLIB "${ZLL_WINDOWS_RANLIB}" CACHE FILEPATH "Windows archive indexer" FORCE)
if(NOT CMAKE_C_COMPILER)
    set(CMAKE_C_COMPILER x86_64-w64-mingw32-gcc)
endif()
if(NOT CMAKE_CXX_COMPILER)
    set(CMAKE_CXX_COMPILER x86_64-w64-mingw32-g++)
endif()
if(NOT CMAKE_RC_COMPILER)
    set(CMAKE_RC_COMPILER x86_64-w64-mingw32-windres)
endif()
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
